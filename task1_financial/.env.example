
# 1. Financial Market Data Parameters
DEFAULT_TICKER=AAPL
LOOKBACK_YEARS=2

# 2. News Headline Ingestion
NEWS_HEADLINES_LIMIT=10

# 3. LLM API Configuration (OpenAI, Groq, OpenRouter, or local Ollama)
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=15

# 4. System Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
